commands:
  01_install_cloudflared_rpm:
    command: |
      ARCH=$(uname -m)
      if [ "$ARCH" = "aarch64" ]; then
        URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-aarch64.rpm"
      else
        URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-x86_64.rpm"
      fi
      dnf install -y $URL
    test: "! command -v cloudflared"

  02_setup_service:
    command: |
      TOKEN=$(/opt/elasticbeanstalk/bin/get-config environment -k CLOUDFLARE_TOKEN)
      if [ -n "$TOKEN" ]; then
        cloudflared service install $TOKEN || true
        
        # Force IPv6 for outbound Cloudflare Edge connections to avoid IPv4 blackhole timeouts
        sed -i 's/cloudflared tunnel run/cloudflared tunnel --edge-ip-version 6 run/g' /etc/systemd/system/cloudflared.service
        
        systemctl daemon-reload
        systemctl enable --now cloudflared
      fi