commands:
  01_create_pgbouncer_configs:
    command: "mkdir -p /var/log/pgbouncer && chown postgres:postgres /var/log/pgbouncer"

container_commands:
  02_generate_pgbouncer_config:
    command: |
      mkdir -p /etc/pgbouncer
      
      # Determine DB_USER based on APP_ENV
      if [ -n "$APP_ENV" ]; then
        DB_USER="${RDS_DB_NAME}_${APP_ENV}"
      else
        DB_USER="${RDS_DB_NAME:-amenities}"
      fi
      
      # Generate pgbouncer.ini with environment variables substituted
      cat > /etc/pgbouncer/pgbouncer.ini <<EOF
      [databases]
      ${DB_USER} = host=${RDS_HOSTNAME} port=${RDS_PORT:-5432} dbname=${DB_USER}
      
      [pgbouncer]
      listen_port = 6432
      listen_addr = 127.0.0.1
      auth_type = plain
      auth_file = /etc/pgbouncer/userlist.txt
      logfile = /var/log/pgbouncer/pgbouncer.log
      pidfile = /var/run/pgbouncer/pgbouncer.pid
      pool_mode = transaction
      max_client_conn = 1000
      default_pool_size = 25
      reserve_pool_size = 5
      reserve_pool_timeout = 3
      EOF
      
      # Generate userlist.txt with DB_USER variable
      cat > /etc/pgbouncer/userlist.txt <<EOF
      "${DB_USER}" "${DB_PASSWORD:-mypassword}"
      EOF
      
      # Set proper permissions
      chown postgres:postgres /etc/pgbouncer/pgbouncer.ini /etc/pgbouncer/userlist.txt
      chmod 640 /etc/pgbouncer/pgbouncer.ini /etc/pgbouncer/userlist.txt
    leader_only: true

services:
  sysvinit:
    pgbouncer:
      enabled: true
      ensureRunning: true
      files:
        - /etc/pgbouncer/pgbouncer.ini
        - /etc/pgbouncer/userlist.txt