files:
  "/opt/elasticbeanstalk/tasks/generatepgbouncerc.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -e
      
      # Source EB environment
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        source /opt/elasticbeanstalk/deployment/env
      fi
      
      mkdir -p /etc/pgbouncer
      
      # Get environment variables (set in EB console)
      RDS_PORT="${RDS_PORT:-5432}"
      RDS_DB_NAME="${RDS_DB_NAME:-amenities}"

      if [ -n $RDS_PASSWORD ]; then
        RDS_PASSWORD=${DB_PASSWORD:-mypassword}
      fi
      
      # Determine DB_USER based on APP_ENV
      if [ -n "$APP_ENV" ]; then
        DB_USER="${RDS_DB_NAME}_${APP_ENV}"
      else
        DB_USER="${RDS_DB_NAME}"
      fi
      
      echo "Generating pgbouncer config with:"
      echo "  DB_USER: $DB_USER"
      echo "  RDS_HOSTNAME: $RDS_HOSTNAME"
      echo "  RDS_PORT: $RDS_PORT"
      echo "  RDS_DB_NAME: $RDS_DB_NAME"
      
      # Generate pgbouncer.ini using printf to avoid heredoc issues
      printf '[databases]\n%s = host=%s port=%s dbname=%s\n\n[pgbouncer]\nlisten_port = 6432\nlisten_addr = 127.0.0.1\nauth_type = md5\nauth_file = /etc/pgbouncer/userlist.txt\nlogfile = /var/log/pgbouncer/pgbouncer.log\npidfile = /var/run/pgbouncer/pgbouncer.pid\npool_mode = transaction\nmax_client_conn = 1000\ndefault_pool_size = 25\nreserve_pool_size = 5\nreserve_pool_timeout = 3\n' "$RDS_DB_NAME" "$RDS_HOSTNAME" "$RDS_PORT" "$RDS_DB_NAME" > /etc/pgbouncer/pgbouncer.ini
      
      # Generate userlist.txt
      printf '"%s" "%s"\n' "$DB_USER" "$RDS_PASSWORD" > /etc/pgbouncer/userlist.txt
      
      # Set proper permissions
      chown pgbouncer:pgbouncer /etc/pgbouncer/pgbouncer.ini /etc/pgbouncer/userlist.txt
      chmod 640 /etc/pgbouncer/pgbouncer.ini /etc/pgbouncer/userlist.txt
      
      echo "pgbouncer config generated successfully"

      # restart pgbouncer if running, to reload config
      PGB_PID = $(pidof pgbouncer)
      if [ -n "$PGB_PID" ]; then
        echo "Restarting pgbouncer..."
        kill -1 $PGB_PID
        echo "pgbouncer restarted successfully"
      fi

commands:
  01_install_rpms:
    command: "dnf install -y spal-release && dnf install -y pgbouncer"

  02_create_pgbouncer_configs:
    command: "mkdir -p /var/log/pgbouncer && chown pgbouncer:pgbouncer /var/log/pgbouncer"

  03_generate_pgbouncer_config:
    command: /opt/elasticbeanstalk/tasks/generatepgbouncerc.sh

services:
  sysvinit:
    pgbouncer:
      enabled: true
      ensureRunning: true